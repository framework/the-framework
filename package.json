{
  "name": "the-framework",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The Framework: autonomous AI programming — coding agents work your repos unattended and hand the result off as pull requests.",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "pnpm -r --filter '!__private__website' run build",
    "// Serve the production build the way an install does: the daemon, not a static server": "",
    "preview": "pnpm build && pnpm -C packages/framework preview",
    "dev": "pnpm build && pnpm -C packages/framework dev",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "========= Website": "",
    "// Develop website https://the-framework.ai locally": "",
    "website": "cd packages/the-framework.ai/ && pnpm run dev",
    "// Build website for production": "",
    "website:build": "cd packages/the-framework.ai/ && pnpm run build",
    "// Test website (CI)": "",
    "website:test": "cd packages/the-framework.ai/ && echo 'no tests yet'"
  },
  "devDependencies": {
    "@openagt/skill-branches": "workspace:*",
    "@openagt/skill-github": "workspace:*",
    "@openagt/skill-tickets": "workspace:*",
    "@openagt/skill-queue": "workspace:*",
    "@openagt/skill-logs": "workspace:*",
    "@openagt/skill-browser": "workspace:*",
    "@openagt/skill-discord": "workspace:*",
    "@openagt/skill-orchestration": "workspace:*",
    "@openagt/agent-runner": "workspace:*",
    "@openagt/agent-scheduler": "workspace:*",
    "typescript": "^7.0.2"
  }
}
