#!/usr/bin/env node
import { runCli } from '../dist/cli.js'

const terminal = process.stdin.isTTY && process.stdout.isTTY ? { input: process.stdin, output: process.stdout } : undefined

runCli(process.argv.slice(2), { cwd: process.cwd(), stdout: line => console.log(line), stderr: line => console.error(line), ...(terminal ? { terminal } : {}) })
  .then(code => {
    process.exitCode = code
  })
  .catch(err => {
    console.error(err)
    process.exitCode = 1
  })
