{
  "name": "@gemstack/skill-discord",
  "version": "0.0.1",
  "description": "Discord as a skill: post one message to a Discord channel through its webhook, set once per machine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framework/the-framework.git",
    "directory": "packages/skill-discord"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin/discord",
    "SKILL.md"
  ],
  "bin": {
    "discord": "bin/discord"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./SKILL.md": "./SKILL.md"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js'",
    "clean": "rm -rf dist dist-test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  }
}
