{
  "name": "@gemstack/skill-github",
  "version": "0.0.1",
  "description": "GitHub as a skill for coding agents: the project's pull requests and issues through gh, and the one command the framework and the scheduler run for the git host: requests, open, merge, home.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framework/the-framework.git",
    "directory": "packages/skill-github"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin/github",
    "SKILL.md"
  ],
  "bin": {
    "github": "bin/github"
  },
  "framework": {
    "git-host": "github"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./SKILL.md": "./SKILL.md"
  },
  "scripts": {
    "build": "pnpm -C ../agent-data build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm -C ../agent-data build && tsc --noEmit",
    "test": "pnpm build && tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js'",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@gemstack/agent-data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  }
}
