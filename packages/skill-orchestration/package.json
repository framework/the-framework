{
  "name": "@gemstack/skill-orchestration",
  "version": "0.0.1",
  "description": "Orchestration as a skill: a main agent starts subagents on parts of its task, each a run of its own on a branch started from the main agent's, and lists them, reads their results and stops them with the orchestration command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framework/the-framework.git",
    "directory": "packages/skill-orchestration"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin/orchestration",
    "SKILL.md"
  ],
  "bin": {
    "orchestration": "bin/orchestration"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./SKILL.md": "./SKILL.md"
  },
  "scripts": {
    "build": "pnpm -C ../agent-runner build && tsc -p tsconfig.build.json",
    "prepack": "node -e \"if(!process.env.npm_config_user_agent?.startsWith('pnpm/')){console.error('Pack and publish with pnpm: it replaces workspace:* with the real version, npm does not');process.exit(1)}\"",
    "typecheck": "pnpm -C ../agent-runner build && tsc --noEmit",
    "test": "pnpm build && tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js'",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@gemstack/agent-data": "workspace:*",
    "@gemstack/skill-branches": "workspace:*",
    "@gemstack/skill-logs": "workspace:*",
    "agent-runner": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "agent-driver": "workspace:*",
    "typescript": "^7.0.2"
  }
}
