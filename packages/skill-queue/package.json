{
  "name": "@gemstack/skill-queue",
  "version": "0.0.1",
  "description": "The agent queue for coding agents: the priority-banded list of what agents work on next, kept on a branch of the project's repository and changed with the queue command.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framework/the-framework.git",
    "directory": "packages/skill-queue"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin/queue",
    "SKILL.md"
  ],
  "bin": {
    "queue": "bin/queue"
  },
  "framework": {
    "queue": "queue"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "default": "./dist/names.js"
    },
    "./SKILL.md": "./SKILL.md",
    "./dashboard": "./dist/dashboard/dashboard.js"
  },
  "scripts": {
    "build": "pnpm -C ../agent-data build && tsc -p tsconfig.build.json && vite build -c dashboard/vite.config.ts",
    "typecheck": "pnpm -C ../agent-data build && tsc --noEmit && tsc --noEmit -p dashboard/tsconfig.json",
    "test": "pnpm build && tsc -p tsconfig.test.json && node --test --test-timeout=60000 'dist-test/**/*.test.js' && cd dashboard && vitest run",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@gemstack/agent-data": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
