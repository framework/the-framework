#!/usr/bin/env node
import { runCli } from '../dist/cli.js'

runCli(process.argv.slice(2), { cwd: process.cwd(), stdin: () => new Promise(resolve => { let data = ''; process.stdin.setEncoding('utf8'); process.stdin.on('data', chunk => { data += chunk }); process.stdin.on('end', () => resolve(data)) }), stdout: line => console.log(line), stderr: line => console.error(line) })
  .then(code => {
    process.exitCode = code
  })
  .catch(err => {
    console.error(err)
    process.exitCode = 1
  })
